{
  "manifest_version": 3,
  "name": "OpenAI Login Helper",
  "version": "2.0.0",
  "description": "Điền email, mật khẩu và mã TOTP cho phiên đăng nhập OpenAI do bạn bắt đầu.",
  "minimum_chrome_version": "120",
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://auth.openai.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "index.html",
    "default_title": "OpenAI Login Helper",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "options_ui": {
    "page": "index.html?manage=1",
    "open_in_tab": true
  },
  "web_accessible_resources": [
    {
      "resources": [
        "panel.html",
        "assets/*"
      ],
      "matches": [
        "https://auth.openai.com/*"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "https://auth.openai.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
