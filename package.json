{
  "name": "openai-login-helper",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "npm run build && node scripts/dev.mjs",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && node --check src/extension/background.js && node --check src/extension/content.js && node --check src/extension/totp.js && node --check src/extension/accounts.js && node --check src/extension/login-target.js",
    "build": "npm run check && vite build && node scripts/extension.mjs",
    "pack": "npm run build && node scripts/pack.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.24",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.7.0",
    "esbuild": "^0.25.0",
    "fflate": "^0.8.2",
    "typescript": "^5.9.0",
    "vite": "^6.4.0"
  }
}
